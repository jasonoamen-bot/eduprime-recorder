# Copy to deploy/.env on the server and fill in. NEVER commit the real file.

# Shared with the LMS (RECORDER_SHARED_SECRET there). 32+ characters.
# Make one with:  openssl rand -hex 32
RECORDER_SHARED_SECRET=

# How many classes this server records at once. Past this it answers "full" and the LMS
# falls back to LiveKit recording for that class. Roughly: (CPU cores) / 2.5.
MAX_CONCURRENT_JOBS=3

# Only these origins may be opened / called back. Comma separated.
ALLOWED_PAGE_ORIGINS=https://easywayschoollms.com.ng
ALLOWED_CALLBACK_ORIGINS=https://easywayschoollms.com.ng

# Where finished recordings go: the Backblaze bucket, with a key that can ONLY use that bucket.
S3_BUCKET=easyway-recordings
S3_REGION=eu-central-003
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_ACCESS_KEY=
S3_SECRET=

# Picture quality. 720p is plenty for 360p cameras; 24 fps keeps motion smooth.
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
VIDEO_CRF=22
VIDEO_PRESET=veryfast

# For the HTTPS option (docker compose --profile https up -d)
RECORDER_DOMAIN=
