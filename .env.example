# Shared secret with the LMS. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECORDER_SHARED_SECRET=

PORT=8787
MAX_CONCURRENT_JOBS=2
MAX_JOB_MINUTES=240

# Only these origins may be opened / called back. Comma separated. Never leave open.
ALLOWED_PAGE_ORIGINS=https://easyway-lms.vercel.app
ALLOWED_CALLBACK_ORIGINS=https://easyway-lms.vercel.app

# Video profile (source cameras are 180p/360p, so 720p loses nothing)
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
VIDEO_CRF=22

# Storage: set S3_* for R2, or LOCAL_OUTPUT_DIR to write files locally (dev)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET=
LOCAL_OUTPUT_DIR=
