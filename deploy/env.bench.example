# Settings for a LOAD TEST on a rented server (not for real classes).
# Files go to a local folder instead of Backblaze, and the recorder serves its own test page.
RECORDER_SHARED_SECRET=
MAX_CONCURRENT_JOBS=8
PAGE_JOIN_TIMEOUT_SECONDS=90
LOCAL_OUTPUT_DIR=/out
SERVE_FIXTURES=1
ALLOWED_PAGE_ORIGINS=http://127.0.0.1:8080
ALLOWED_CALLBACK_ORIGINS=http://127.0.0.1
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
VIDEO_CRF=22
VIDEO_PRESET=veryfast
